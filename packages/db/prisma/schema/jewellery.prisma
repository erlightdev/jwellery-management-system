model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]

  @@index([name])
  @@map("customer")
}

model Supplier {
  id        String     @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Product[]
  purchases Purchase[]

  @@index([name])
  @@map("supplier")
}

model Product {
  id           String         @id @default(cuid())
  sku          String         @unique
  name         String
  category     String
  metalType    String
  purity       String?
  grossWeight  Decimal        @db.Decimal(10, 3)
  netWeight    Decimal        @db.Decimal(10, 3)
  metalRate    Decimal        @db.Decimal(12, 2)
  makingCharge Decimal        @db.Decimal(12, 2) @default(0)
  wastageCharge Decimal       @db.Decimal(12, 2) @default(0)
  stoneCharge  Decimal        @db.Decimal(12, 2) @default(0)
  taxRate      Decimal        @db.Decimal(5, 2)  @default(0)
  barcode      String?        @unique
  qrCode       String?        @db.Text
  status       String         @default("active")
  supplierId   String?
  supplier     Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventory    Inventory?
  saleItems    SaleItem[]
  purchaseItems PurchaseItem[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([name])
  @@index([category])
  @@index([supplierId])
  @@map("product")
}

model Inventory {
  id             String   @id @default(cuid())
  productId      String   @unique
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int      @default(0)
  reorderLevel   Int      @default(1)
  location       String?
  lastStockCheck DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("inventory")
}

model Sale {
  id             String     @id @default(cuid())
  invoiceNumber  String     @unique
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  subtotal       Decimal    @db.Decimal(12, 2)
  discount       Decimal    @db.Decimal(12, 2) @default(0)
  tax            Decimal    @db.Decimal(12, 2) @default(0)
  total          Decimal    @db.Decimal(12, 2)
  paidAmount     Decimal    @db.Decimal(12, 2) @default(0)
  paymentStatus  String     @default("pending")
  paymentMethod  String?
  notes          String?    @db.Text
  saleDate       DateTime   @default(now())
  dueDate        DateTime?
  items          SaleItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([customerId])
  @@index([saleDate])
  @@map("sale")
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description   String
  weight        Decimal  @db.Decimal(10, 3)
  metalRate     Decimal  @db.Decimal(12, 2)
  makingCharge  Decimal  @db.Decimal(12, 2) @default(0)
  wastageCharge Decimal  @db.Decimal(12, 2) @default(0)
  stoneCharge   Decimal  @db.Decimal(12, 2) @default(0)
  taxRate       Decimal  @db.Decimal(5, 2)  @default(0)
  discount      Decimal  @db.Decimal(12, 2) @default(0)
  lineTotal     Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

model Purchase {
  id             String         @id @default(cuid())
  purchaseNumber String         @unique
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  total          Decimal        @db.Decimal(12, 2)
  paidAmount     Decimal        @db.Decimal(12, 2) @default(0)
  paymentStatus  String         @default("pending")
  purchaseDate   DateTime       @default(now())
  dueDate        DateTime?
  notes          String?        @db.Text
  items          PurchaseItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([supplierId])
  @@index([purchaseDate])
  @@map("purchase")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity   Int
  unitCost   Decimal  @db.Decimal(12, 2)
  lineTotal  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_item")
}
